  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^4.0.5",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.0.0",
